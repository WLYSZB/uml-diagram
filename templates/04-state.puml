@startuml
!include theme.puml
' ============ 状态机图模板 ============
' [*] 表示初态/终态
' 复合状态用 state 名字 { ... } 包起来
' 并发用 -- 分隔

[*] --> 待支付

state "待支付" as 待支付 {
  [*] --> 校验库存
  校验库存 --> 等待支付 : 通过
}

待支付 --> 已支付 : 支付成功
待支付 --> 已取消 : 超时 / 用户取消
已支付 --> 已发货 : 发货
已发货 --> 已完成 : 确认收货

已取消 --> [*]
已完成 --> [*]

@enduml
