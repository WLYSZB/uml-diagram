@startuml
!include theme.puml
' 图书馆借阅系统 · 部署图

node "自助借还机" {
  [借还客户端]
}

node "读者手机" {
  [小程序]
}

node "校园网 · DMZ" {
  node "Nginx 集群" {
    [反向代理 1]
    [反向代理 2]
  }
}

node "应用服务器区" {
  node "应用节点 A" {
    [借阅服务]
    [库存服务]
  }
  node "应用节点 B" {
    [通知服务]
    [信用服务]
  }
}

node "数据服务器区" {
  database "MySQL 主从" as DB
  queue "RabbitMQ" as MQ
}

[借还客户端] --> [反向代理 1] : HTTPS
[小程序] --> [反向代理 2] : HTTPS
[反向代理 1] --> [借阅服务]
[反向代理 2] --> [借阅服务]
[借阅服务] --> DB : JDBC
[库存服务] --> DB
[借阅服务] --> MQ
[通知服务] --> MQ

@enduml
