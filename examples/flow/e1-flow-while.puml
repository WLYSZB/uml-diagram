@startuml
!include ../../templates/theme.puml
' @diagram program-flow
title 程序流程图：班级平均分统计（当型循环）

start
:输入学生总数 n;
:sum = 0;
:i = 1;
while (i <= n ?) is (是)
  :输入第 i 名学生成绩 s;
  if (s < 0 或 s > 100 ?) then (是)
    :提示成绩无效;
  else (否)
    :sum = sum + s;
  endif
  :i = i + 1;
endwhile (否)
:avg = sum / n;
:输出 avg;
stop
@enduml
